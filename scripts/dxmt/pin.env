# Pinned inputs for scripts/build-dxmt.sh. Every download is checked against
# the sha256 here before it is used.
#
# Base: upstream 3Shain/dxmt main at the commit SteaMac (fxgl/steamac@79aeadb,
# host/dxmt/pin.env) pinned. scripts/dxmt/patches/ are SteaMac's patches
# 0001-0023 from that commit, unchanged (authors kept in each From: line).
# Not taken: 0024/0027 (their README), 0025/0026 (VR eye-texture export).
# DXMT and the patches are LGPL-2.1-or-later; the build writes a matching
# source tarball next to the binary package.
DXMT_VERSION=0.80-fable.1
DXMT_COMMIT=e94c312f5c054263acf261cfa109edf13e757587
DXMT_URL=https://github.com/3Shain/dxmt/archive/e94c312f5c054263acf261cfa109edf13e757587.tar.gz
DXMT_SHA256=fcdc10e14f1a7b42c8136c819807cbc42157f2d78eccdb34c82131cb3a929bf3

# Submodules at the commits e94c312 records.
DXHEADERS_COMMIT=9df86f2341616ef1888ae59919feaa6d4fad693d
DXHEADERS_URL=https://github.com/misyltoad/mingw-directx-headers/archive/9df86f2341616ef1888ae59919feaa6d4fad693d.tar.gz
DXHEADERS_SHA256=9c1b8bbfd2d6c758fac4d93c2808a46bc1eee429fe656b4f21b29e02615aa8aa
NVAPI_COMMIT=d08488fcc82eef313b0464db37d2955709691e94
NVAPI_URL=https://github.com/NVIDIA/nvapi/archive/d08488fcc82eef313b0464db37d2955709691e94.tar.gz
NVAPI_SHA256=436936c965f711f743c8606cb7c2621736cecf41e0fd6557555b2f1903b0350f

# Toolchains of DXMT's own CI (.github/workflows/ci.yml at e94c312).
# The Wine build supplies winebuild, winecrt0 and the import libraries.
WINE_URL=https://github.com/3Shain/wine/releases/download/v8.16-3shain/wine.tar.gz
WINE_SHA256=289c7f19e270a3d3d0a6fdb07691b176c70a0795f6811e5255cba82425de4f10
# airconv (the DXBC -> Metal shader compiler) links LLVM 15 statically.
LLVM_VERSION=15.0.7
LLVM_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-15.0.7/llvm-project-15.0.7.src.tar.xz
LLVM_SHA256=8b5fcb24b4128cf04df1b0b9410ce8b1a729cb3c544e6da885d234280dedeac6
